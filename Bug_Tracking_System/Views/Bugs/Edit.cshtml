@model Bug_Tracking_System.Models.ViewModels.BugCreateEditViewModel

@{
    ViewData["Title"] = "Edit Bug";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4><i class="bi bi-pencil-square me-2"></i>Edit Bug #@Model.Bug.Id</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Bug.Id" />
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Bug.Title" class="form-label">Title</label>
                            <input asp-for="Bug.Title" class="form-control" />
                            <span asp-validation-for="Bug.Title" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Bug.Description" class="form-label">Description</label>
                        <textarea asp-for="Bug.Description" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Bug.Description" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Bug.ProjectId" class="form-label">Project</label>
                            <select asp-for="Bug.ProjectId" asp-items="@Model.Projects" class="form-select">
                                <option value="">-- Select Project --</option>
                            </select>
                            <span asp-validation-for="Bug.ProjectId" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="Bug.AssignedToId" class="form-label">Assign To</label>
                            <select asp-for="Bug.AssignedToId" asp-items="@Model.Users" class="form-select">
                                <option value="">-- Unassigned --</option>
                            </select>
                            <span asp-validation-for="Bug.AssignedToId" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Bug.Status" class="form-label">Status</label>
                            <select asp-for="Bug.Status" asp-items="@Model.Statuses" class="form-select">
                            </select>
                            <span asp-validation-for="Bug.Status" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="Bug.Priority" class="form-label">Priority</label>
                            <select asp-for="Bug.Priority" asp-items="@Model.Priorities" class="form-select">
                            </select>
                            <span asp-validation-for="Bug.Priority" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back to List
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
