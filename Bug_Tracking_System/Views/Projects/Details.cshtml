@model Bug_Tracking_System.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Projects
    </a>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="bi bi-folder2 me-2"></i>@Model.Name</h4>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash me-1"></i>Delete
            </a>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "No description available" : Model.Description)</p>
        
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="stat-card bg-secondary text-white">
                    <h3>@(Model.Bug?.Count ?? 0)</h3>
                    <p>Total Bugs</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card bg-warning text-dark">
                    <h3>@(Model.Bug?.Count(b => b.Status == "Open") ?? 0)</h3>
                    <p>Open Bugs</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card bg-success text-white">
                    <h3>@(Model.Bug?.Count(b => b.Status == "Closed" || b.Status == "Resolved") ?? 0)</h3>
                    <p>Resolved Bugs</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-bug me-2"></i>Project Bugs</h5>
        <a asp-controller="Bugs" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Report Bug
        </a>
    </div>
    <div class="card-body">
        @if (Model.Bug == null || !Model.Bug.Any())
        {
            <p class="text-muted text-center py-4">No bugs reported for this project yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Assigned To</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bug in Model.Bug)
                        {
                            <tr>
                                <td>@bug.Title</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(bug.Status)">@bug.Status</span>
                                </td>
                                <td>
                                    <span class="badge @GetPriorityBadgeClass(bug.Priority)">@bug.Priority</span>
                                </td>
                                <td>@(bug.AssignedTo?.FullName ?? "Unassigned")</td>
                                <td>
                                    <a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string? status) => status switch
    {
        "Open" => "bg-warning text-dark",
        "In Progress" => "bg-info",
        "Resolved" => "bg-success",
        "Closed" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string GetPriorityBadgeClass(string? priority) => priority switch
    {
        "Critical" => "bg-danger",
        "High" => "bg-orange",
        "Medium" => "bg-warning text-dark",
        "Low" => "bg-success",
        _ => "bg-light text-dark"
    };
}
