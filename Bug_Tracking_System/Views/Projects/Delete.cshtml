@model Bug_Tracking_System.Models.Project

@{
    ViewData["Title"] = "Delete Project";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4><i class="bi bi-exclamation-triangle me-2"></i>Delete Project</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    Are you sure you want to delete this project? This action cannot be undone.
                </div>
                
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>
                    
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@(Model.Description ?? "No description")</dd>
                    
                    <dt class="col-sm-3">Bugs</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-secondary">@(Model.Bug?.Count ?? 0) bugs</span>
                        @if (Model.Bug?.Count > 0)
                        {
                            <small class="text-danger d-block mt-1">
                                Warning: Deleting this project will also delete all associated bugs!
                            </small>
                        }
                    </dd>
                </dl>
                
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete Project
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
