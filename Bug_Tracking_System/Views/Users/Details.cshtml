@model Bug_Tracking_System.Models.User

@{
    ViewData["Title"] = Model.FullName;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Team
    </a>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <div class="user-avatar mb-3">
                    <i class="bi bi-person-circle display-1 text-primary"></i>
                </div>
                <h4>@Model.FullName</h4>
                <p class="text-muted">@Model.Email</p>
                <span class="badge @GetRoleBadgeClass(Model.Role) mb-3">@Model.Role</span>
                
                <hr />
                
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash me-1"></i>Delete
                    </a>
                </div>
            </div>
        </div>
        
        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Statistics</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Assigned Bugs</span>
                    <span class="badge bg-primary">@(Model.AssignedBugs?.Count ?? 0)</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Comments</span>
                    <span class="badge bg-secondary">@(Model.Comment?.Count ?? 0)</span>
                </div>
                @if (Model.AssignedBugs != null)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>Open Bugs</span>
                        <span class="badge bg-warning text-dark">@Model.AssignedBugs.Count(b => b.Status == "Open")</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Closed Bugs</span>
                        <span class="badge bg-success">@Model.AssignedBugs.Count(b => b.Status == "Closed" || b.Status == "Resolved")</span>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-bug me-2"></i>Assigned Bugs</h5>
            </div>
            <div class="card-body">
                @if (Model.AssignedBugs == null || !Model.AssignedBugs.Any())
                {
                    <p class="text-muted text-center py-4">No bugs assigned to this user.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Project</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bug in Model.AssignedBugs)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark">#@bug.Id</span></td>
                                        <td>@bug.Title</td>
                                        <td>@bug.Project?.Name</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(bug.Status)">@bug.Status</span>
                                        </td>
                                        <td>
                                            <span class="badge @GetPriorityBadgeClass(bug.Priority)">@bug.Priority</span>
                                        </td>
                                        <td>
                                            <a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetRoleBadgeClass(string? role) => role switch
    {
        "Admin" => "bg-danger",
        "Manager" => "bg-warning text-dark",
        "Developer" => "bg-primary",
        "Tester" => "bg-info",
        _ => "bg-secondary"
    };

    string GetStatusBadgeClass(string? status) => status switch
    {
        "Open" => "bg-warning text-dark",
        "In Progress" => "bg-info",
        "Resolved" => "bg-success",
        "Closed" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string GetPriorityBadgeClass(string? priority) => priority switch
    {
        "Critical" => "bg-danger",
        "High" => "bg-orange",
        "Medium" => "bg-warning text-dark",
        "Low" => "bg-success",
        _ => "bg-light text-dark"
    };
}
